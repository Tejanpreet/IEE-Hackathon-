# Copy to backend/.env and fill in. Never commit .env.

# Where the teammate's risk-engine repo lives (absolute or relative to backend/).
# Leave blank to serve mock data. Live: RISK_ENGINE_PATH=../vendor/risk-engine (git submodule)
RISK_ENGINE_PATH=

# Any keys the teammate's scripts need (examples — rename to match their code):
# CER_API_KEY=
# OTHER_SERVICE_KEY=

# Frontend origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
