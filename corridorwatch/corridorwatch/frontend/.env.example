# Copy to .env.local and fill in. Never commit .env.local.

# Google Maps JavaScript API browser key.
# Restrict it in Google Cloud Console → Credentials → HTTP referrers: http://localhost:5173/* and your demo domain.
VITE_GOOGLE_MAPS_API_KEY=

# true = use built-in mock data (no backend needed). false = call FastAPI via /api.
VITE_USE_MOCKS=false
